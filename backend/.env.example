APP_NAME=Split Karo
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# Render PostgreSQL provides a postgres:// URL. The app converts it to the
# async SQLAlchemy driver automatically.
DATABASE_URL=postgres://user:password@host:5432/database

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated origins are supported for Netlify preview and production URLs.
FRONTEND_URL=https://your-site.onrender.com

COOKIE_NAME=split_karo_session
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
# Use none when the frontend and backend are hosted on different domains.
COOKIE_SAMESITE=none

AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-gemini-key
AI_MODEL=gemini-2.5-flash